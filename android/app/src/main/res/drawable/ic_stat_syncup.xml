<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar icon for pushes. Android draws small icons as a silhouette:
     anything non-transparent becomes solid white, so this is a single flat
     shape. Without it FCM falls back to the launcher icon, which silhouettes
     into a featureless white square. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,16.17L4.83,12l-1.42,1.41L9,19 21,7l-1.41,-1.41z"/>
</vector>
